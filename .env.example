# ============================================================================
# DEEPEVIL — Configuração de Busca, Ollama e Qdrant Vector DB (.env.example)
# Architected by Erik Tonon · EdgeSearch & PE-AGENTS-IBM
# ============================================================================

PORT=3000
HOST=127.0.0.1

# 1. Provedor de Busca Web:
# - "searxng" (Recomendado: Meta-buscador open-source local em http://127.0.0.1:8888 — 100% gratuito e sem chave!)
# - "keyless" (Busca direta DuckDuckGo HTML via undici sem precisar de container nem chave)
# - "brave"   (API oficial do Brave Search caso possua uma BRAVE_SEARCH_API_KEY)
SEARCH_PROVIDER=searxng
SEARXNG_URL=http://127.0.0.1:8888
BRAVE_SEARCH_API_KEY=searxng

# 2. Provedor de LLM: "ollama" (Local / GPU), "anthropic" (Claude) ou "openai" (GPT)
LLM_PROVIDER=ollama

# Opção A: Ollama Local (100% gratuito na máquina local — seletor dinâmico via /api/tags)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=granite4.2:latest
OLLAMA_NUM_CTX=16384

# 3. Persistência Híbrida Enterprise: Qdrant Vector DB + SQLite WAL
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=deepevil_conversations
DB_PATH=./data/perplexity.sqlite

# Opção B: Anthropic Claude
ANTHROPIC_API_KEY=sua_chave_anthropic_aqui
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Opção C: OpenAI GPT
OPENAI_API_KEY=sua_chave_openai_aqui
OPENAI_MODEL=gpt-4o-mini

PAGE_FETCH_TIMEOUT_MS=8000
MAX_CHARS_PER_SOURCE=4500
