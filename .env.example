# ============================================================================
# DEEPEVIL — Worldwide Research & Local AI Answer Engine (.env.example)
# Architected by Erik Tonon · EdgeSearch & PE-AGENTS-IBM
# ============================================================================

PORT=3000
HOST=127.0.0.1

# 1. Provedor de Busca Web Global (Worldwide Research):
# - "keyless" (Padrão Zero-Config: DuckDuckGo Worldwide + Federação Wikipedia 7 Polos, OpenAlex, Crossref, Yandex/CyberLeninka Runet, Habr, ArXiv, GitHub, HN e Bing Global)
# - "searxng" (Meta-buscador open-source local em http://127.0.0.1:8888 com motor Yandex ativo e fallback automático para keyless)
# - "brave"   (API oficial do Brave Search caso possua uma BRAVE_SEARCH_API_KEY)
SEARCH_PROVIDER=keyless
SEARXNG_URL=http://127.0.0.1:8888
BRAVE_SEARCH_API_KEY=keyless
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# 2. Provedor de LLM: "ollama" (100% Local / GPU), "anthropic" (Claude) ou "openai" (GPT)
LLM_PROVIDER=ollama

# Opção A: Ollama Local (Baixe o modelo oficial com: ollama pull eriktonon/granite4.2-uncensored:latest)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=eriktonon/granite4.2-uncensored:latest
OLLAMA_NUM_CTX=32768

# 3. Persistência Híbrida Opcional: Qdrant Vector DB + SQLite WAL Local
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=deepevil_conversations
DB_PATH=./data/perplexity.sqlite

# Opção B (Opcional): Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Opção C (Opcional): OpenAI GPT
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

PAGE_FETCH_TIMEOUT_MS=6500
MAX_CHARS_PER_SOURCE=5500
